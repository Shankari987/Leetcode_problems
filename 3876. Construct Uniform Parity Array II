class Solution {
    public boolean uniformArray(int[] nums1) {

        int smallestOdd = Integer.MAX_VALUE;
        boolean hasEven = false;

        for (int num : nums1) {

            if (num % 2 == 0) {
                hasEven = true;
            } else {
                smallestOdd = Math.min(smallestOdd, num);
            }
        }

        if (smallestOdd == Integer.MAX_VALUE) {
            return true;
        }

        if (!hasEven) {
            return true;
        }

        
        for (int num : nums1) {

            if (num % 2 == 0 && num <= smallestOdd) {
                return false;
            }
        }

        return true;
    }
}

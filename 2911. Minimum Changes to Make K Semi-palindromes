
class Solution {
    public int minimumChanges(String s, int k) {

        int n = s.length();

        int[][] cost = new int[n][n];

        // Step 1: Calculate minimum changes for every substring
        for (int i = 0; i < n; i++) {

            for (int j = i + 1; j < n; j++) {

                int len = j - i + 1;
                cost[i][j] = Integer.MAX_VALUE;

                for (int d = 1; d < len; d++) {

                    if (len % d != 0) {
                        continue;
                    }

                    int changes = 0;

                    for (int r = 0; r < d; r++) {

                        int left = i + r;
                        int right = i + r
                                + ((len - 1 - r) / d) * d;

                        while (left < right) {

                            if (s.charAt(left) != s.charAt(right)) {
                                changes++;
                            }

                            left += d;
                            right -= d;
                        }
                    }

                    cost[i][j] = Math.min(cost[i][j], changes);
                }
            }
        }

        // Step 2: Dynamic Programming
        int INF = 1000000;

        int[][] dp = new int[k + 1][n + 1];

        for (int p = 0; p <= k; p++) {
            for (int i = 0; i <= n; i++) {
                dp[p][i] = INF;
            }
        }

        dp[0][0] = 0;

        for (int p = 1; p <= k; p++) {

            for (int i = 2 * p; i <= n; i++) {

                for (int j = 2 * (p - 1); j <= i - 2; j++) {

                    dp[p][i] = Math.min(
                        dp[p][i],
                        dp[p - 1][j] + cost[j][i - 1]
                    );
                }
            }
        }

        return dp[k][n];
    }
}

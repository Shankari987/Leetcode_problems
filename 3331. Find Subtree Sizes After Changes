
import java.util.*;

class Solution {
    public int[] findSubtreeSizes(int[] parent, String s) {

        int n = parent.length;

        List<Integer>[] children = new ArrayList[n];

        for (int i = 0; i < n; i++) {
            children[i] = new ArrayList<>();
        }

        for (int i = 1; i < n; i++) {
            children[parent[i]].add(i);
        }

        int[] newParent = new int[n];

        int[] last = new int[26];
        Arrays.fill(last, -1);

        int[] previous = new int[n];

        int[] stack = new int[2 * n + 1];
        int top = 0;

        stack[top++] = 0;

        while (top > 0) {

            int x = stack[--top];

            if (x < 0) {

                int node = ~x;
                int ch = s.charAt(node) - 'a';

                last[ch] = previous[node];

                continue;
            }

            int ch = s.charAt(x) - 'a';

            previous[x] = last[ch];

            if (x == 0) {
                newParent[x] = -1;
            } else if (last[ch] != -1) {
                newParent[x] = last[ch];
            } else {
                newParent[x] = parent[x];
            }

            last[ch] = x;

            stack[top++] = ~x;

            for (int child : children[x]) {
                stack[top++] = child;
            }
        }

        List<Integer>[] newChildren = new ArrayList[n];

        for (int i = 0; i < n; i++) {
            newChildren[i] = new ArrayList<>();
        }

        for (int i = 1; i < n; i++) {
            newChildren[newParent[i]].add(i);
        }

        // Step 4: Traverse modified tree
        int[] order = new int[n];
        int[] st = new int[n];

        int size = 0;
        top = 0;

        st[top++] = 0;

        while (top > 0) {

            int node = st[--top];

            order[size++] = node;

            for (int child : newChildren[node]) {
                st[top++] = child;
            }
        }

        int[] answer = new int[n];

        Arrays.fill(answer, 1);

        for (int i = n - 1; i > 0; i--) {

            int node = order[i];

            answer[newParent[node]] += answer[node];
        }

        return answer;
    }
}

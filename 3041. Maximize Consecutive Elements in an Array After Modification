class Solution {
    public int maxSelectedElements(int[] nums) {

        Arrays.sort(nums);

        HashMap<Integer, Integer> dp = new HashMap<>();

        int ans = 0;

        for (int num : nums) {

            int prev = dp.getOrDefault(num, 0);
            int keep = dp.getOrDefault(num - 1, 0) + 1;

            dp.put(num, Math.max(
                dp.getOrDefault(num, 0), keep
            ));

            dp.put(num + 1, Math.max(
                dp.getOrDefault(num + 1, 0), prev + 1
            ));

            ans = Math.max(ans, dp.get(num));
            ans = Math.max(ans, dp.get(num + 1));
        }

        return ans;
    }
}
